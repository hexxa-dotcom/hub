# ============================================================
# Hexxa Hub — variáveis de ambiente (copie para .env.local)
# ATENÇÃO: este projeto tem banco PRÓPRIO, separado do hexxa-tasks.
# ============================================================

# --- Banco de dados (Supabase Postgres dedicado ao Hub) ---
DATABASE_URL="postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="..."
SUPABASE_SERVICE_ROLE_KEY="..."

# --- Integração: NFSe (ex.: Focus NFe / PlugNotas / eNotas) ---
NFSE_PROVIDER="focus"          # focus | plugnotas | enotas | mock
NFSE_API_TOKEN="..."
NFSE_API_BASE_URL="https://api.focusnfe.com.br"

# --- Integração: Assinatura eletrônica (ex.: Clicksign / D4Sign / ZapSign) ---
SIGNATURE_PROVIDER="clicksign"  # clicksign | d4sign | zapsign | mock
SIGNATURE_API_TOKEN="..."
SIGNATURE_API_BASE_URL="https://app.clicksign.com/api/v3"

# --- Integração: Open Finance (ex.: Pluggy / Belvo) ---
OPEN_FINANCE_PROVIDER="pluggy"  # pluggy | belvo | mock
OPEN_FINANCE_CLIENT_ID="..."
OPEN_FINANCE_CLIENT_SECRET="..."

# --- Índices econômicos (reajuste de aluguel) ---
ECON_INDEX_PROVIDER="bcb"       # bcb (Banco Central séries IPCA/IGP-M) | mock

# --- MCP Server ---
MCP_TRANSPORT="stdio"           # stdio | http
MCP_HTTP_PORT="8787"
