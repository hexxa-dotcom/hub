# ============================================================
# Hexxa Hub — variáveis de ambiente (copie para .env.local)
# ATENÇÃO: este projeto tem banco PRÓPRIO, separado do hexxa-tasks.
# ============================================================

# --- Banco de dados (Supabase Postgres dedicado ao Hub) ---
# DATABASE_URL: role padrão (postgres), usado só por rotas admin que
# legitimamente cruzam empresas — hoje tem BYPASSRLS.
DATABASE_URL="postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres"
# TENANT_DATABASE_URL: role restrito (hexxa_app, sem BYPASSRLS) usado por
# withTenant() em toda rota do portal do cliente — RLS isola cada empresa de
# verdade. Crie o role com packages/db/migrations/manual_create_tenant_role.sql
# antes de configurar esta variável. Sem ela, o app cai para DATABASE_URL.
TENANT_DATABASE_URL="postgresql://hexxa_app:[password]@db.[ref].supabase.co:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="..."
SUPABASE_SERVICE_ROLE_KEY="..."

# --- Autenticação (Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="..."
CLERK_SECRET_KEY="..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/auth/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/auth/login"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/onboarding"

# --- Acesso ao painel admin (allowlist por e-mail/CNPJ) ---
ADMIN_ALLOWED_EMAILS="voce@hexxa.com.br,outro@hexxa.com.br"
ADMIN_ALLOWED_CNPJS=""

# --- Integração: NFSe (Emissor Nacional / gov.br) ---
GOV_BR_CLIENT_ID="..."
NFSE_CERT_PFX_BASE64="..."         # certificado A1 (.pfx) em base64
NFSE_CERT_PASSWORD="..."

# --- Integração: Assinatura eletrônica (DocuSeal) ---
DOCUSEAL_API_KEY="..."             # usado por packages/integrations (geração de template/submissão)
DOCUSEAL_TOKEN="..."               # usado por api/docuseal/token (embed do widget no front)
DOCUSEAL_WEBHOOK_SECRET="..."      # configure o webhook no DocuSeal para .../api/webhooks/docuseal?secret=<isto>

# --- Integração: Pagamentos/Cobrança (Asaas) ---
ASAAS_API_KEY="..."
ASAAS_ENV="sandbox"                 # sandbox | production
ASAAS_WEBHOOK_TOKEN="..."

# --- Consulta de CNPJ (onboarding) ---
CNPJA_API_KEY="..."                 # opcional: sem chave, cai no fallback ReceitaWS

# --- Índices econômicos (reajuste de aluguel) ---
ECON_INDEX_PROVIDER="bcb"           # bcb (Banco Central séries IPCA/IGP-M) | mock

# --- Cron jobs (fechamento mensal) ---
CRON_SECRET="..."                   # protege api/cron/fechamento contra chamadas externas

# --- Suporte ---
NEXT_PUBLIC_SUPPORT_WHATSAPP="5511999999999"

# --- MCP Server ---
MCP_TRANSPORT="stdio"           # stdio | http
MCP_HTTP_PORT="8787"
